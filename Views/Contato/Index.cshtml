@model IEnumerable<ProjetoMVC.Models.Contato>
@{
    ViewData["Title"] = "Contatos";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <span class="text-primary fw-semibold small text-uppercase">Gerenciamento</span>
        <h1 class="display-6 fw-bold mb-1">Contatos</h1>
        <p class="text-secondary mb-0">Consulte e gerencie seus contatos cadastrados.</p>
    </div>
    <a asp-action="Criar" class="btn btn-primary"><span aria-hidden="true">＋</span> Novo contato</a>
</div>

<div class="card page-card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Id)</th>
                        <th>@Html.DisplayNameFor(model => model.Nome)</th>
                        <th>@Html.DisplayNameFor(model => model.Telefone)</th>
                        <th>@Html.DisplayNameFor(model => model.Ativo)</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-secondary py-5">Nenhum contato cadastrado.</td></tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-secondary">#@item.Id</td>
                            <td class="fw-semibold">@item.Nome</td>
                            <td>@item.Telefone</td>
                            <td><span class="badge rounded-pill @(item.Ativo ? "text-bg-success" : "text-bg-secondary")">@(item.Ativo ? "Ativo" : "Inativo")</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Detalhes" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                                <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                <a asp-action="Deletar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
