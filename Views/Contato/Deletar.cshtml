@model ProjetoMVC.Models.Contato
@{
    ViewData["Title"] = "Excluir contato";
}

<div class="row justify-content-center"><div class="col-lg-7">
    <div class="card page-card border-start border-danger border-4"><div class="card-body p-4 p-lg-5">
        <div class="text-danger fs-1 mb-3" aria-hidden="true">⚠</div><h1 class="h2">Excluir contato?</h1><p class="text-secondary">Esta ação é permanente. Confirme abaixo para remover o contato.</p>
        <dl class="row my-4"><dt class="col-sm-4 text-secondary">Nome</dt><dd class="col-sm-8 fw-semibold">@Model.Nome</dd><dt class="col-sm-4 text-secondary">Telefone</dt><dd class="col-sm-8">@Model.Telefone</dd><dt class="col-sm-4 text-secondary">Status</dt><dd class="col-sm-8">@(Model.Ativo ? "Ativo" : "Inativo")</dd></dl>
        <form asp-action="Deletar" class="d-flex gap-2"><input type="hidden" asp-for="Id" /><button type="submit" class="btn btn-danger">Sim, excluir</button><a asp-action="Index" class="btn btn-light">Cancelar</a></form>
    </div></div>
</div></div>
