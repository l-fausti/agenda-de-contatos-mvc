@model ProjetoMVC.Models.Contato
@{
    ViewData["Title"] = "Editar contato";
}

<div class="row justify-content-center"><div class="col-lg-7">
    <div class="mb-4"><span class="text-primary fw-semibold small text-uppercase">Contatos</span><h1 class="display-6 fw-bold">Editar contato</h1><p class="text-secondary">Atualize as informações de <strong>@Model.Nome</strong>.</p></div>
    <div class="card page-card"><div class="card-body p-4 p-lg-5">
        <form asp-action="Editar">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3"><label asp-for="Nome" class="form-label fw-semibold"></label><input asp-for="Nome" class="form-control form-control-lg" /><span asp-validation-for="Nome" class="text-danger small"></span></div>
            <div class="mb-3"><label asp-for="Telefone" class="form-label fw-semibold"></label><input asp-for="Telefone" class="form-control form-control-lg" /><span asp-validation-for="Telefone" class="text-danger small"></span></div>
            <div class="form-check form-switch mb-4"><input asp-for="Ativo" class="form-check-input" /><label asp-for="Ativo" class="form-check-label">Contato ativo</label></div>
            <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">Salvar alterações</button><a asp-action="Index" class="btn btn-light">Cancelar</a></div>
        </form>
    </div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
